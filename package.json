{
  "name": "cardnest-concept-demo",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:whatsapp": "playwright test --config playwright.whatsapp.config.ts",
    "seed:generate": "node scripts/generate-seed.ts",
    "art:generate": "node scripts/generate-product-art.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs package.json tsconfig.json",
    "format:check": "prettier --check src tests scripts *.ts *.mjs package.json tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "agent-browser": "0.38.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
